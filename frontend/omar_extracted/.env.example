# BlockLearnX Application Environment Variables

# Supabase Authentication & Database Configuration
# Get these from your Supabase Dashboard: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Legacy Auth Keys (Optional Fallbacks)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Application Settings
NODE_ENV=development
